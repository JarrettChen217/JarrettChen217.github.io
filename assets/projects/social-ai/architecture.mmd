flowchart TB
    accTitle: SocialAI · 配图、发帖与检索 / Create, publish and search
    accDescr: Create sends a scene description to Go and previews the generated image before the user decides whether to publish. Collection searches indexed posts and fetches the image by URL.
    create["React · Create<br/>描述画面 / Describe a scene"]
    collection["React · Collection<br/>关键词搜帖 / Search posts"]
    api["Go HTTP<br/>路由与服务 / Router + services<br/>同一进程 / One process"]
    provider["OpenAI / Gemini<br/>按配置选择 / Configured provider"]
    es[("Elasticsearch<br/>帖子索引 / Post index")]
    gcs[("Google Cloud Storage<br/>媒体文件 / Media files")]
    create -->|"提交描述 / Send prompt"| api
    api -->|"预览后决定发布<br/>Preview, then choose to post"| create
    collection <-->|"搜索与结果<br/>Query + results"| api
    api <-->|"生成图片 / Generate image"| provider
    api <-->|"写入与检索 / Index + query"| es
    api -->|"发布时保存 / Save on publish"| gcs
    collection -->|"按 URL 取图 / Load by URL"| gcs
    classDef client fill:#e8f1ed,stroke:#3f705a,color:#183c2e,stroke-width:2px;
    classDef service fill:#faf1d9,stroke:#a18b50,color:#493d20,stroke-width:2px;
    classDef store fill:#edf1f6,stroke:#648091,color:#263c49,stroke-width:2px;
    class create,collection client
    class api service
    class es,gcs,provider store
