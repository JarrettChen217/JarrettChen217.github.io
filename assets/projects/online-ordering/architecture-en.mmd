flowchart TB
    accTitle: Online Food Ordering · Cart architecture
    accDescr: React calls the same-origin API through Nginx. In the Spring Boot process, Spring Security supplies the identity, CustomerService resolves the customer, and CartService uses JDBC and a per-customer Caffeine cache.
    ui["React<br/>Browser"]
    nginx["Nginx<br/>Static assets + API proxy"]
    subgraph app["Spring Boot · One process"]
        cart["Spring Security → CartController<br/>CustomerService → CartService"]
        cache["Caffeine<br/>Cache by customer ID"]
        cart <-->|"Lookup or evict"| cache
    end
    db[("PostgreSQL<br/>Items + total")]
    ui -->|"Same-origin HTTP"| nginx
    nginx -->|"/cart"| cart
    cart <-->|"Spring Data JDBC"| db
    classDef client fill:#e8f1ed,stroke:#3f705a,color:#183c2e,stroke-width:2px;
    classDef service fill:#faf1d9,stroke:#a18b50,color:#493d20,stroke-width:2px;
    classDef store fill:#edf1f6,stroke:#648091,color:#263c49,stroke-width:2px;
    class ui,nginx client
    class cart service
    class cache,db store
    style app fill:#f4f3e9,stroke:#b0ac85,color:#473e27,stroke-width:1px
