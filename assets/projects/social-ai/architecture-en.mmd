flowchart TB
    accTitle: SocialAI · Create, publish and search
    accDescr: Create sends a scene description to Go and previews the generated image before the user decides whether to publish. Collection searches indexed posts and fetches the image by URL.
    create["React · Create<br/>Describe a scene"]
    collection["React · Collection<br/>Search posts"]
    api["Go HTTP<br/>Router + services<br/>One process"]
    provider["OpenAI / Gemini<br/>Configured provider"]
    es[("Elasticsearch<br/>Post index")]
    gcs[("Google Cloud Storage<br/>Media files")]
    create -->|"Send prompt"| api
    api -->|"Preview, then choose to post"| create
    collection <-->|"Query + results"| api
    api <-->|"Generate image"| provider
    api <-->|"Index + query"| es
    api -->|"Save on publish"| gcs
    collection -->|"Load by URL"| gcs
